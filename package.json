{
	"name": "write-aac-metadata",
	"version": "1.0.13",
	"description": "Deprecated: use node-taglib-sharp directly to write AAC metadata",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"scripts": {
		"build": "tsc -p ./tsconfig.release.json",
		"build:test": "tsc -p ./tsconfig.test.json",
		"test": "npm run build:test && mocha",
		"lint": "eslint . --report-unused-disable-directives-severity error",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc -p ./tsconfig.json --noEmit",
		"coverage": "npm run build:test && npx nyc@latest mocha"
	},
	"files": [
		"dist/**/*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chris-shaw-2011/write-aac-metadata.git"
	},
	"keywords": [
		"aac",
		"m4a",
		"m4b",
		"metadata"
	],
	"author": "Chris Shaw",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/chris-shaw-2011/write-aac-metadata/issues"
	},
	"homepage": "https://github.com/chris-shaw-2011/write-aac-metadata#readme",
	"dependencies": {
		"node-taglib-sharp": "^6.0.3",
		"utimes": "5.2.1"
	},
	"devDependencies": {
		"@chris-shaw-2011/lint": "^1.0.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.1.2",
		"mocha": "^11.7.6",
		"music-metadata": "^11.14.0",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"utimes@5.2.1": true
	}
}
